# Backend settings. The Go server does not load .env files automatically.
# OIDC settings enable Authentik login and take precedence over ADMIN_API_TOKEN.
AUTHENTIK_ISSUER_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URL=
# Generate with: openssl rand -hex 32
AUTHENTIK_SESSION_SECRET=
# Optional comma-separated Authentik group names; requires a "groups" ID-token claim.
AUTHENTIK_ALLOWED_GROUPS=

# Legacy single-admin login, used only when Authentik OIDC is not configured.
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=
TARGET_NAMESPACES=default,other
LISTEN_ADDR=127.0.0.1:8080

# Optional; defaults to in-cluster config or ~/.kube/config.
# KUBECONFIG=/home/you/.kube/config